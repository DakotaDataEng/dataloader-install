# Copy this file to vars.env in this folder and fill in the values. Keep vars.env private.
# Every name is in the Variables tables of docs/runbooks/client-acceptance-test-plan.md.
# All values below are made up. Secrets are left empty or as kv:// references.
# Live lines are the Postgres-to-Postgres basics. A commented line names the
# TAGS value (or the case) that turns it on. Uncomment it and add the tag.

# Install and host
BASE_URL=http://127.0.0.1:8080
PUBLIC_URL=https://dataloader.client.example
INSTALL_DIR=/opt/dataloader
COMPOSE=docker compose -f /opt/dataloader/docker-compose.deploy.yml
DATA_VOLUME=dataloader_dataloader-data
IMAGE_TAG=0.1.82
EXPECTED_VERSION=0.1.82
LICENSE_JSON=
# Run the cli checks on the host from another machine:
# HOST_SHELL=ssh si@dl-host.client.example

# What this install has. Cases needing a tag that is not listed are N/A.
TAGS=src:postgres,dest:postgres,https,license

# Users and sign-in
ADMIN_EMAIL=dl-admin@client.example
ADMIN_PASSWORD=
# Second local admin for CAT-AUTH-23 only. No TAGS value. Uncomment for that case.
# ADMIN2_EMAIL=dl-admin2@client.example
# ADMIN2_PASSWORD=
# Created by CAT-AUTH-13 and the roles checks. No TAGS value. Uncomment for those cases.
# EDITOR_EMAIL=dl-editor@client.example
# EDITOR_PASSWORD=
# VIEWER_EMAIL=dl-viewer@client.example
# VIEWER_PASSWORD=
# SVC_EMAIL=dl-svc-acceptance@client.example

# SSO (section 3). Set TAGS to include sso.
# SSO_ISSUER_URL=https://login.microsoftonline.com/11111111-1111-4111-8111-111111111111/v2.0
# SSO_CLIENT_ID=22222222-2222-4222-8222-222222222222
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=https://dataloader.client.example/api/v1/auth/oidc/callback
# SSO_ALLOWED_DOMAIN=client.example

# Sources. Postgres is live. Each other source type is commented out.
SRC_POSTGRES_CONFIG={"host":"pg.client.example","port":5432,"database":"sales","username":"dl_ro","password":"kv://client-kv/pg-password"}
SRC_POSTGRES_BAD_CONFIG={"host":"pg.client.example","port":5432,"database":"sales","username":"dl_ro","password":"wrong-password"}
# Set TAGS to include azure (Postgres password from Key Vault).
# SRC_POSTGRES_KV_CONFIG={"host":"pg.client.example","port":5432,"database":"sales","username":"dl_ro","password":"kv://client-kv/pg-password"}
SRC_POSTGRES_SCHEMA=public
SRC_POSTGRES_TABLE=dl_acceptance
SECRET_PROBE=
# Set TAGS to include src:mssql.
# SRC_MSSQL_CONFIG={"host":"mssql.client.example","port":1433,"database":"sales","username":"dl_ro","password":"kv://client-kv/mssql-password"}
# Set TAGS to include src:oracle.
# SRC_ORACLE_CONFIG={"host":"oracle.client.example","port":1521,"service_name":"SALES","username":"dl_ro","password":"kv://client-kv/oracle-password"}
# Set TAGS to include src:snowflake.
# SRC_SNOWFLAKE_CONFIG={"account":"client-acct","warehouse":"DL_WH","database":"SALES","schema":"PUBLIC","username":"DL_RO","password":"kv://client-kv/snowflake-password"}
# Set TAGS to include src:clickhouse.
# SRC_CLICKHOUSE_CONFIG={"host":"ch.client.example","port":8443,"database":"sales","username":"dl_ro","password":"kv://client-kv/ch-password"}
# Set TAGS to include src:iceberg.
# SRC_ICEBERG_CONFIG={"catalog_uri":"https://iceberg.client.example","warehouse":"lake","token":"kv://client-kv/iceberg-token"}

# Loads and schedules (Postgres source to Postgres destination)
# Saved by CAT-CONN-02. Change it only to load from another source.
LOAD_SRC_ID=${CONN_POSTGRES_ID}
LOAD_SRC_SCHEMA=public
LOAD_SRC_TABLE=dl_acceptance
LOAD_SRC_ROWS=250
LOAD_SRC_PK=id
LOAD_SRC_PK_JSON=["id"]
LOAD_SRC_WATERMARK=updated_at
LOAD_SRC_DSN=
LOAD_SRC_INSERT_SQL=INSERT INTO public.dl_acceptance (id, name, updated_at) SELECT max(id) + 1, 'cat', now() FROM public.dl_acceptance
CRON_TZ=America/Denver
WEBHOOK_SECRET=

# Destinations. Postgres is live. Each other destination type is commented out.
DEST_POSTGRES_CONFIG={"host":"pgdw.client.example","port":5432,"database":"dw","username":"dl_loader","password":"kv://client-kv/dw-password"}
DEST_POSTGRES_SCHEMA=dl_acceptance
# psql reads postgres:// targets; other targets need a <TARGET>_CMD that
# reads SQL on stdin and prints the first value.
DEST_POSTGRES_DSN=
# Saved by CAT-DEST-01. Change it only to mark another destination as default.
DEST_DEFAULT_ID=${DEST_POSTGRES_ID}
# Set TAGS to include dest:databricks.
# DEST_DATABRICKS_CONFIG={"server_hostname":"adb-0000000000000000.0.azuredatabricks.net","http_path":"/sql/1.0/warehouses/0000000000000000","client_id":"44444444-4444-4444-8444-444444444444","client_secret":"kv://client-kv/dbx-secret"}
# DEST_DATABRICKS_CATALOG=sandbox
# DEST_DATABRICKS_SCHEMA=dl_acceptance
# DEST_DATABRICKS_DSN=
# Set TAGS to include dest:snowflake.
# DEST_SNOWFLAKE_CONFIG={"account":"client-acct","warehouse":"DL_WH","username":"DL_LOADER","password":"kv://client-kv/snowflake-password"}
# DEST_SNOWFLAKE_CATALOG=SANDBOX
# DEST_SNOWFLAKE_SCHEMA=DL_ACCEPTANCE
# DEST_SNOWFLAKE_DSN=
# Set TAGS to include dest:iceberg.
# DEST_ICEBERG_CONFIG={"catalog_uri":"https://iceberg.client.example","warehouse":"lake","token":"kv://client-kv/iceberg-token"}
# DEST_ICEBERG_CATALOG=lake
# DEST_ICEBERG_SCHEMA=dl_acceptance
# DEST_ICEBERG_DSN=

# Notifications. Set TAGS to include notify.
# NOTIFY_CHANNEL_TYPE=teams_webhook
# NOTIFY_CHANNEL_CONFIG=
# NOTIFY_EMAIL_TO=dl-alerts@client.example
# EMAIL_TRANSPORT_JSON=

# Access policies (section 17). Set TAGS to include dest:databricks or dest:snowflake.
# ACC_GROUP=payroll_readers
# ACC_TEXT_COLUMN=name
# ACC_FILTER_COLUMN=region
# ACC_FILTER_VALUE=north

# dbt and automation (section 18). Set TAGS to include dbt.
# DBT_PROJECT_BODY=
# DBT_MODEL_KEY=orders_clean
# Dagster cases only. Set TAGS to include dagster.
# DAGSTER_URL=https://dagster.client.example/prod
# DAGSTER_CODE_LOCATION=sales
# DAGSTER_TOKEN=

# Azure (section 9). Set TAGS to include azure.
# AZ_TENANT_ID=11111111-1111-4111-8111-111111111111
# AZ_SUBSCRIPTION_ID=66666666-6666-4666-8666-666666666666
# AZ_RG=rg-dataloader-client
# AZ_SP_CLIENT_ID=77777777-7777-4777-8777-777777777777
# AZ_SP_CLIENT_SECRET=
# AZ_KV_NAME=client-dl-kv
# AZ_KV_URI=https://client-dl-kv.vault.azure.net/
# AZ_KV_PROBE_VALUE=
# AZ_MI_CLIENT_ID=88888888-8888-4888-8888-888888888888
# AZ_MI_RESOURCE_ID=/subscriptions/66666666-6666-4666-8666-666666666666/resourceGroups/rg-dataloader-client/providers/Microsoft.ManagedIdentity/userAssignedIdentities/dl-mi
# AZ_ACR_NAME=clientdlacr
# AZ_ACR_LOGIN_SERVER=clientdlacr.azurecr.io
# AZ_WORKER_TAG=1.0.0
# AZ_ACA_ENV_ID=/subscriptions/66666666-6666-4666-8666-666666666666/resourceGroups/rg-dataloader-client/providers/Microsoft.App/managedEnvironments/dl-env
# AZ_CALLBACK_BASE=https://dataloader.client.example

# Azure fan-out (section 9). Set TAGS to include azure, and point these at a large source table.
# FANOUT_SRC_ID=99999999-9999-4999-8999-999999999999
# FANOUT_SRC_SCHEMA=public
# FANOUT_SRC_TABLE=dl_large
# FANOUT_SRC_ROWS=2000000
# FANOUT_PARTITION_COLUMN=id
# FANOUT_THRESHOLD=100000

# Jobs (section 22). No TAGS value. Uncomment to run section 22.
# JOB_BODY={"name":"acceptance-jobs","environment":"test","job_type":"databricks","connection_id":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","settings":{},"timeout_secs":600}

# Upgrade cases (section 14): a second, newer tag. Set TAGS to include upgrade.
# UPGRADE_TAG=1.0.1
# UPGRADE_VERSION=1.0.1
